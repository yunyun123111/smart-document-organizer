# ===== Smart Document Organizer 环境变量模板 =====
# 复制为 .env 后按需修改

APP_NAME=SmartDocumentOrganizer
APP_ENV=development
DEBUG=true

# 数据库
DATABASE_URL=sqlite:///./data/database/app.db

# 目录（默认使用相对 data/ 目录，可改为绝对路径如 D:/文档库）
DOCUMENT_ROOT=./data/documents
INBOX_ROOT=./data/inbox
TEMP_DIR=./data/temp

# 日志
LOG_LEVEL=INFO
LOG_DIR=./data/logs

# 文件操作
# 归档时是否允许覆盖同名文件（默认 false，禁止覆盖）
ALLOW_OVERWRITE=false

# OCR（V1 使用 PaddleOCR，P4 阶段安装启用）
OCR_ENABLED=true

# AI（OpenAI Compatible API）
AI_ENABLED=true
AI_PROVIDER=openai        # openai | deepseek | qwen | ollama | custom
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=60
AI_MAX_RETRIES=2
AI_MAX_TEXT_LENGTH=8000   # 发送给 AI 的最大文本长度

# 置信度阈值
AUTO_ARCHIVE_THRESHOLD=0.85
REVIEW_THRESHOLD=0.60

# 置信度权重（总和应为 1.0）
CONF_RULE_WEIGHT=0.40
CONF_FIELD_WEIGHT=0.20
CONF_KEYWORD_WEIGHT=0.15
CONF_AI_WEIGHT=0.25
